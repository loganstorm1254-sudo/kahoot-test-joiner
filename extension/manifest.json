{
  "manifest_version": 3,
  "name": "Blooket Join Helper",
  "version": "1.1.0",
  "description": "Lets the Kahoot/Blooket test joiner send joins from your browser.",
  "host_permissions": [
    "https://fb.blooket.com/*",
    "https://play.blooket.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kahoot-test-joiner.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["joiner-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
